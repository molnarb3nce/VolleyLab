# Used only by the e2e tests (npm run test:e2e). Contains no real secrets.
# The tests use their own Postgres schema ("test") in the local dev database,
# so they never touch the data in the "public" schema.
DATABASE_URL="postgresql://volleylab:volleylab@localhost:5432/volleylab?schema=test"
JWT_SECRET="e2e-test-secret"
JWT_EXPIRES_IN="1h"
