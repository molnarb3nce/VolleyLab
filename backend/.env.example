# Local development database (see ../docker-compose.yml)
DATABASE_URL="postgresql://volleylab:volleylab@localhost:5432/volleylab?schema=public"
PORT=3000

# Secret used to sign JWTs. Use a long random value; never reuse this one.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="1d"

# Production (Railway): browser origin(s) allowed by CORS, comma-separated.
# CORS_ORIGIN="https://your-frontend.up.railway.app"
# Or alias:
# FRONTEND_URL="https://your-frontend.up.railway.app"
